{
  "name": "evolvex/laravel-shadow-runtime",
  "description": "Production dark-deployment and behavioral verification runtime for Laravel business logic.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "shadow",
    "dark deployment",
    "production",
    "comparison",
    "refactor",
    "sandbox"
  ],
  "authors": [
    {
      "name": "Evolvex"
    }
  ],
  "require": {
    "php": "^8.2|^8.3|^8.4|^8.5",
    "illuminate/cache": "^11.0|^12.0|^13.0",
    "illuminate/console": "^11.0|^12.0|^13.0",
    "illuminate/container": "^11.0|^12.0|^13.0",
    "illuminate/contracts": "^11.0|^12.0|^13.0",
    "illuminate/database": "^11.0|^12.0|^13.0",
    "illuminate/events": "^11.0|^12.0|^13.0",
    "illuminate/http": "^11.0|^12.0|^13.0",
    "illuminate/log": "^11.0|^12.0|^13.0",
    "illuminate/mail": "^11.0|^12.0|^13.0",
    "illuminate/notifications": "^11.0|^12.0|^13.0",
    "illuminate/queue": "^11.0|^12.0|^13.0",
    "illuminate/support": "^11.0|^12.0|^13.0",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0|^10.0|^11.0",
    "phpunit/phpunit": "^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "Evolvex\\ShadowRuntime\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Evolvex\\ShadowRuntime\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Evolvex\\ShadowRuntime\\ShadowRuntimeServiceProvider"
      ],
      "aliases": {
        "Shadow": "Evolvex\\ShadowRuntime\\Facades\\Shadow"
      }
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "find src tests database -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
